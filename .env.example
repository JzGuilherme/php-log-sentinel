# Application Environment
APP_ENV=production
APP_DEBUG=false
SERVICE_NAME=ecommerce-checkout-api

# Database Configuration (MySQL 8.0+)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=log_sentinel
DB_USERNAME=sentinel_user
DB_PASSWORD=your_db_password_here

# Google Gemini AI Configuration (Root-Cause Diagnostics)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Triage Worker & Rate Control
WORKER_SLEEP_SECONDS=3
WORKER_MAX_MEMORY_MB=128
INCIDENT_COOLDOWN_MINUTES=60

# DevOps Alerting Webhooks (Slack / Discord / Microsoft Teams)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/your_webhook_token_here
ALERT_MIN_SEVERITY=high
