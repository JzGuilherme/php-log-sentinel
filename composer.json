{
  "name": "jzguilherme/php-log-sentinel",
  "description": "Privacy-first PHP 8.2+ incident triage and log auditing engine with automated LGPD/GDPR PII scrubbing (CPF, credit cards, JWTs), SHA-256 error fingerprinting deduplication, and AI root-cause diagnostics via Google Gemini 2.5 Flash.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "José Guilherme",
      "homepage": "https://github.com/JzGuilherme"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "monolog/monolog": "^3.5",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "JzGuilherme\\LogSentinel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JzGuilherme\\LogSentinel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests --level=8"
  },
  "config": {
    "sort-packages": true
  }
}
